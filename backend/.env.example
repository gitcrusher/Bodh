# ============================================================
# AI News App — environment variables
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres + pgvector) ---
# Local dev example:  postgres://user:pass@localhost:5432/ai_news
# Supabase/Neon:      copy the connection string from their dashboard
DATABASE_URL=postgres://ai_news:ai_news@localhost:5432/ai_news

# --- LLM providers ---
# Google Gemini — free tier. Create keys at https://aistudio.google.com/
# Two keys for quota pooling; GEMINI_API_KEY_2 is optional but recommended.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Groq — free tier. Sign up at https://console.groq.com/
GROQ_API_KEY=

# Anthropic — paid. https://console.anthropic.com/
# Leave blank to skip; the router will fall through to free-tier providers.
ANTHROPIC_API_KEY=

# --- LLM router config ---
# Comma-separated priority list. First = highest priority.
# Available: gemini_1, gemini_2, groq, anthropic, fake
LLM_PROVIDER_PRIORITY=gemini_1,gemini_2,groq,anthropic
LLM_MAX_RETRIES=2
LLM_CIRCUIT_BREAKER_THRESHOLD=3   # consecutive failures before a provider is skipped

# Default models per provider
GEMINI_MODEL=gemini-1.5-flash-latest
GROQ_MODEL=llama-3.1-8b-instant
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Embedding service ---
# Pinned. Changing this requires a full re-embed migration.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- External API keys ---
# OpenAlex — required since Feb 2026. Register at https://openalex.org/
OPENALEX_API_KEY=

# Semantic Scholar — free key requested by form (emailed). https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# --- arXiv fetcher ---
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
ARXIV_BASE_URL=https://export.arxiv.org
ARXIV_RATE_LIMIT_SECONDS=3        # One request per 3 seconds per arXiv policy

# --- Daily ingestion ---
DAILY_CARD_BUDGET=50              # Max cards to create per run
DAILY_TOKEN_BUDGET=500000         # Approximate token ceiling per run

# --- Feature flags ---
FEATURE_RESEARCH_MODULE=true

# --- Retention ---
RAW_CONTENT_GRACE_DAYS=7         # Days before raw_content is cleared
RAW_EMBEDDING_RETENTION_DAYS=90
AGENT_RUNS_FULL_RETENTION_DAYS=14
DB_USAGE_ALERT_PCT=80

# --- Single-user local build ---
# No login screen in v1. Django admin superuser is the only user.
# Run: python manage.py createsuperuser
SUPERUSER_EMAIL=admin@localhost
