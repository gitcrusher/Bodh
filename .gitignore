# ===========================================================================
# AI News App — Comprehensive Git Ignore
# ===========================================================================

# ---------------------------------------------------------------------------
# Python & Virtual Environments (Rule: Never commit venv or bytecode)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
backend/.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ---------------------------------------------------------------------------
# Environment Variables & Secrets (Rule: NEVER commit secrets or API keys)
# ---------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
backend/.env.*
!.env.example
!backend/.env.example
!*.env.example

# ---------------------------------------------------------------------------
# Databases (Local test/dev databases)
# ---------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
db.sqlite3
backend/db.sqlite3
*.db

# ---------------------------------------------------------------------------
# Testing, Linter & Cache Artifacts
# ---------------------------------------------------------------------------
.pytest_cache/
backend/.pytest_cache/
.import_linter_cache/
backend/.import_linter_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
nosetests.xml
*.cover
*.py,cover
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Flutter & Dart (client/ build artifacts & cache)
# ---------------------------------------------------------------------------
.dart_tool/
client/.dart_tool/
.flutter-plugins
client/.flutter-plugins
.flutter-plugins-dependencies
client/.flutter-plugins-dependencies
.packages
client/.packages
.pub-cache/
client/.pub-cache/
.pub/
client/.pub/
client/build/
client/coverage/

# Platform-specific Ephemeral & Generated Files
client/windows/flutter/ephemeral/
client/macos/Flutter/ephemeral/
client/linux/flutter/ephemeral/
client/android/.gradle/
client/android/app/build/
client/android/local.properties
client/android/key.properties
client/android/.cxx/
client/ios/.generated/
client/ios/Flutter/Flutter.framework
client/ios/Flutter/Flutter.podspec
client/ios/Flutter/Generated.xcconfig
client/ios/Flutter/app.framework
client/ios/Pods/
client/ios/.symlinks/

# Keystores & sensitive credentials
*.keystore
*.jks

# ---------------------------------------------------------------------------
# IDE & System Files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.log
*.log.*

# IntelliJ / Android Studio
.idea/
client/.idea/
*.iml
client/*.iml
client/android/*.iml
*.ipr
*.iws

# VS Code (preserve shared workspace settings & configs)
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json

# Scratch & Temporary Folders
scratch/
*/scratch/
temp/
tmp/
*.tmp
*.bak
*~
.gemini/
.antigravity/
